---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = '固始县永和高级中学 · 学校信息站：学校简介、校园风光、校园动态与招生信息。',
} = Astro.props;

const fullTitle =
  title === '首页'
    ? '固始县永和高级中学 · 永怀梦想，和衷共济'
    : `${title} · 固始县永和高级中学`;

// 对外展示统一用中文域名（IDN）；DNS 与证书的机器形式由 GitHub Pages 的 CNAME 处理
const SITE_ORIGIN = 'https://永和高中.love';
const canonical = `${SITE_ORIGIN}${Astro.url.pathname}`;
const siteName = '固始县永和高级中学 · 学校信息站';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta property="og:image" content="https://xn--fiq18monwfu6b.love/brand/logo.png" />
    <meta property="og:image:width" content="256" />
    <meta property="og:image:height" content="256" />
    <meta property="og:image:alt" content="固始县永和高级中学校徽" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#4E1512" />
    <link rel="icon" type="image/png" sizes="64x64" href="/brand/favicon.png" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
    <title>{fullTitle}</title>
    <script is:inline>
      // 渐进增强标记：无 JS 时内容保持可见，动画只在支持 JS 的环境启用
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">跳到主要内容</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script is:inline>
      const toggle = document.querySelector('.nav-toggle');
      const nav = document.getElementById('site-nav');
      if (toggle && nav) {
        toggle.addEventListener('click', () => {
          const open = nav.classList.toggle('is-open');
          toggle.setAttribute('aria-expanded', String(open));
        });
        nav.addEventListener('click', (event) => {
          if (event.target.closest('a')) {
            nav.classList.remove('is-open');
            toggle.setAttribute('aria-expanded', 'false');
          }
        });
      }

      const items = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window && items.length) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.12 }
        );
        items.forEach((el) => io.observe(el));
      } else {
        items.forEach((el) => el.classList.add('is-visible'));
      }

      // 复制本站地址（文中直接给中文域名，粘贴出来就是「永和高中.love」）
      document.querySelectorAll('.copy-link').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const text = btn.getAttribute('data-copy') || '';
          const original = btn.textContent;
          try {
            await navigator.clipboard.writeText(text);
            btn.textContent = '已复制';
          } catch {
            btn.textContent = text;
          }
          setTimeout(() => {
            btn.textContent = original;
          }, 2200);
        });
      });
    </script>
  </body>
</html>
