---
interface Props {
  size?: number;
  withText?: boolean;
}
const { size = 44, withText = false } = Astro.props;
const uid = Math.random().toString(36).slice(2, 8);
const arcTop = `crest-arc-top-${uid}`;
const arcBottom = `crest-arc-bottom-${uid}`;
---

<svg
  class="crest"
  width={size}
  height={size}
  viewBox="0 0 200 200"
  role="img"
  aria-label="固始县永和高级中学校徽"
>
  <defs>
    <path id={arcTop} d="M 13,100 A 87,87 0 0 1 187,100" fill="none"></path>
    <path id={arcBottom} d="M 13,100 A 87,87 0 0 0 187,100" fill="none"></path>
  </defs>
  <circle cx="100" cy="100" r="97" fill="#1E7A4F"></circle>
  {
    withText && (
      <g fill="#F7F2E8">
        <text font-family="Georgia, 'Songti SC', serif" font-size="14.5" letter-spacing="3">
          <textPath href={`#${arcTop}`} startOffset="50%" text-anchor="middle">
            固始县永和高级中学
          </textPath>
        </text>
        <text font-family="Georgia, serif" font-size="10" letter-spacing="2.4">
          <textPath href={`#${arcBottom}`} startOffset="50%" text-anchor="middle">
            YONGHE HIGH SCHOOL
          </textPath>
        </text>
      </g>
    )
  }
  <circle cx="100" cy="100" r="74" fill="#FBF8F1"></circle>
  <circle cx="100" cy="100" r="72" fill="none" stroke="#C9A24B" stroke-width="1.4"></circle>
  <circle cx="100" cy="88" r="26" fill="#C23B2E"></circle>
  <text
    x="100"
    y="138"
    text-anchor="middle"
    font-family="Georgia, 'Times New Roman', serif"
    font-style="italic"
    font-size="48"
    fill="#241F1C"
  >yH</text>
</svg>
