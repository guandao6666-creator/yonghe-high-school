---
import Crest from './Crest.astro';

const pathname = Astro.url.pathname;
const links = [
  { href: '/', label: '首页' },
  { href: '/about/', label: '学校简介' },
  { href: '/campus/', label: '校园风光' },
  { href: '/news/', label: '校园动态' },
  { href: '/admissions/', label: '招生信息' },
  { href: '/contact/', label: '联系我们' },
];

const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="永和高中首页">
      <Crest size={40} />
      <span class="brand-text">
        <span class="cn">永和高中</span>
        <span class="en">Yonghe High School</span>
      </span>
    </a>

    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      aria-label="打开导航菜单"
    >
      <span></span>
    </button>

    <nav id="site-nav" class="nav" aria-label="主导航">
      {
        links.map((link) => (
          <a
            href={link.href}
            aria-current={isActive(link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
