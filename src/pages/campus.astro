---
import Base from '../layouts/Base.astro';
import SectionTitle from '../components/SectionTitle.astro';
import VideoCard from '../components/VideoCard.astro';
import { campusTiles, campusNote, campusPhoto } from '../data/school';
import { videos } from '../data/videos';

const campusVideos = [videos[5], videos[1], videos[2]];
---

<Base
  title="校园风光"
  description="永和高中校园实拍：红砖教学楼、银灰穹顶、大校门、运动场、春日花枝与校名题字。"
>
  <section class="page-hero">
    <div class="container page-hero-inner">
      <nav class="breadcrumb" aria-label="面包屑">
        <a href="/">首页</a>
        <span>/</span>
        <span>校园风光</span>
      </nav>
      <h1>校园风光</h1>
      <p>
        红砖教学楼、银灰色穹顶、石柱门楼与红色跑道——永和高中有一副很好认的样子。
        这一页是镜头里的校园实拍。
      </p>
    </div>
  </section>

  <section class="section section--paper">
    <div class="container">
      <div class="reveal">
        <SectionTitle
          kicker="Scenes"
          title="六个熟悉的<em>校园画面</em>"
          desc="以下为校园实拍照片，由学校师生提供。"
        />
      </div>
      <div class="tile-grid">
        {
          campusTiles.map((tile) => (
            <article class={`tile tile--${tile.key} reveal`}>
              <img
                class="tile-photo"
                src={tile.photo}
                alt={tile.photoAlt}
                loading="lazy"
                decoding="async"
              />
              <div class="tile-body">
                <h3>{tile.title}</h3>
                <p>{tile.desc}</p>
              </div>
            </article>
          ))
        }
      </div>
      <figure class="photo-band reveal">
        <img src={campusPhoto.src} alt={campusPhoto.alt} loading="lazy" decoding="async" />
        <figcaption>{campusPhoto.caption}</figcaption>
      </figure>
      <p style="margin-top:14px;font-size:12px;color:var(--muted)">{campusNote}</p>
    </div>
  </section>

  <section class="section section--cream">
    <div class="container">
      <div class="reveal">
        <SectionTitle
          kicker="On Douyin"
          title="镜头里的永和"
          desc="下面的视频来自学校官方账号与师生账号。点击卡片可直接在抖音查看原视频。"
        />
      </div>
      <div class="video-grid">
        {campusVideos.map((video) => <VideoCard video={video} />)}
      </div>
      <p style="margin-top:22px">
        <a href="/news/" style="color:var(--red-700);font-weight:600">查看全部校园动态 →</a>
      </p>
    </div>
  </section>
</Base>
