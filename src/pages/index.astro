---
import Base from '../layouts/Base.astro';
import SectionTitle from '../components/SectionTitle.astro';
import VideoCard from '../components/VideoCard.astro';
import Crest from '../components/Crest.astro';
import {
  school,
  stats,
  honors,
  features,
  campusTiles,
  aboutParagraphs,
} from '../data/school';
import { videos, douyinNote } from '../data/videos';

const previewVideos = videos.slice(0, 3);
const previewTiles = campusTiles.slice(0, 3);

const heroSlides = [
  {
    src: '/photos/hero-gate.jpg',
    width: 1400,
    height: 1050,
    alt: '傍晚的永和高中校门：银灰穹顶、红砖主楼与金色校名题字',
    caption: '校门 · 傍晚',
  },
  {
    src: '/photos/aerial-gate.jpg',
    width: 1200,
    height: 900,
    alt: '从空中俯瞰永和高中：红砖楼群、银灰穹顶、校门与两侧的红色跑道',
    caption: '校园 · 航拍',
  },
  {
    src: '/photos/zhili.jpg',
    width: 1200,
    height: 900,
    alt: '红砖立面的知理楼，楼身有金色「知理楼」三字',
    caption: '知理楼 · 红砖与香樟',
  },
  {
    src: '/photos/corridor.jpg',
    width: 1244,
    height: 700,
    alt: '傍晚的走廊，窗外是落日与「和馨」楼',
    caption: '走廊 · 落日',
  },
  {
    src: '/photos/track.jpg',
    width: 1200,
    height: 900,
    alt: '红色跑道与绿茵场，远处是红砖教学楼和成排绿树',
    caption: '运动场 · 红色跑道',
  },
  {
    src: '/photos/aerial-campus.jpg',
    width: 1200,
    height: 900,
    alt: '校园中庭航拍，地面的校训标语写着「永怀梦想 和衷共济」',
    caption: '中庭 · 校训标语',
  },
];
---

<Base
  title="首页"
  description="固始县永和高级中学：2004 年创办于固始县城北环路中段，校训「永怀梦想，和衷共济」。学校简介、校园风光、校园动态与招生信息。"
>
  <section class="hero">
    <div class="container hero-inner">
      <div>
        <span class="hero-kicker">Gushi Yonghe High School</span>
        <h1>固始县永和高级中学</h1>
        <p class="hero-en">Founded 2004 · Gushi, Henan</p>
        <p class="hero-motto">{school.motto}</p>
        <p class="hero-sub">
          红砖与银顶之间，是一所创办于 2004 年的民办公助高中。这里记录它的样子、它的课堂，
          以及一届又一届永和人的青春。
        </p>
        <div class="hero-badges">
          <span>河南省优秀民办学校</span>
          <span>清华大学生源中学</span>
          <span>信阳市示范性普通高中</span>
        </div>
        <div class="hero-actions">
          <a class="btn btn-primary" href="/about/">认识永和 →</a>
          <a class="btn btn-ghost" href="/campus/">看看校园</a>
        </div>
      </div>
      <figure
        class="hero-photo hero-carousel reveal"
        data-carousel
        tabindex="0"
        role="group"
        aria-label="校园照片轮播"
      >
        <div class="carousel-viewport">
          {
            heroSlides.map((slide, i) => (
              <div
                class="carousel-slide"
                data-active={i === 0 ? 'true' : 'false'}
                data-caption={slide.caption}
              >
                <img
                  src={slide.src}
                  alt={slide.alt}
                  width={slide.width}
                  height={slide.height}
                  loading={i === 0 ? 'eager' : 'lazy'}
                  fetchpriority={i === 0 ? 'high' : 'auto'}
                  decoding="async"
                />
              </div>
            ))
          }
        </div>
        <figcaption class="carousel-caption">{heroSlides[0].caption}</figcaption>
        <button
          class="carousel-arrow prev"
          type="button"
          data-dir="-1"
          aria-label="上一张校园照片"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path
              d="M15 5 8 12l7 7"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </button>
        <button
          class="carousel-arrow next"
          type="button"
          data-dir="1"
          aria-label="下一张校园照片"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path
              d="m9 5 7 7-7 7"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </button>
        <div class="carousel-dots" hidden>
          {
            heroSlides.map((slide, i) => (
              <button
                class="carousel-dot"
                type="button"
                data-index={i}
                aria-label={`切换到：${slide.caption}`}
                aria-selected={i === 0 ? 'true' : 'false'}
              />
            ))
          }
        </div>
      </figure>
    </div>
  </section>

  <section class="stats">
    <div class="container stats-inner">
      {
        stats.map((stat) => (
          <div class="stat">
            <div class="stat-value">
              {stat.value}
              {stat.unit && <span class="unit">{stat.unit}</span>}
            </div>
            <div class="stat-label">{stat.label}</div>
            <div class="stat-note">{stat.note}</div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="section section--paper">
    <div class="container split">
      <div class="prose reveal">
        <SectionTitle
          kicker="About"
          title="一所从<em>2004</em> 年走来的高中"
          desc="民办公助、全封闭管理、小班分层教学——永和高中用二十余年时间，成为固始县城北一张熟悉的教育名片。"
        />
        <p>{aboutParagraphs[0]}</p>
        <p>{aboutParagraphs[1]}</p>
        <p style="margin-top:22px">
          <a href="/about/" style="color:var(--red-700);font-weight:600;letter-spacing:.04em">
            继续阅读学校简介与校史 →
          </a>
        </p>
      </div>

      <div class="motto-card reveal">
        <Crest size={76} />
        <p class="motto">永怀梦想<br />和衷共济</p>
        <p class="motto-sub">校训 · SCHOOL MOTTO</p>
        <a class="motto-link" href="/about/">查看学校档案与荣誉 →</a>
      </div>
    </div>
  </section>

  <section class="section section--cream">
    <div class="container">
      <div class="reveal">
        <SectionTitle
          kicker="Features"
          title="把书教好，也把人照顾好"
          desc="全封闭管理、小班分层、清华附中网校与完善的生活配套——这些是家长最关心的日常。"
        />
      </div>
      <div class="grid grid--2">
        {
          features.map((feature, index) => (
            <article class="card feature reveal">
              <span class="feature-num">{String(index + 1).padStart(2, '0')}</span>
              <h3>{feature.title}</h3>
              <p>{feature.desc}</p>
            </article>
          ))
        }
      </div>
      <div class="chips reveal" style="margin-top:32px">
        {honors.map((honor) => <span class="chip">{honor.title}</span>)}
      </div>
    </div>
  </section>

  <section class="section section--paper">
    <div class="container">
      <div class="reveal">
        <SectionTitle
          kicker="Campus"
          title="红砖、银顶与<em>一块黑板</em>"
          desc="从校门到操场，从晚自习的教室到秋天的落叶——这里是永和高中被镜头记录下来的样子。"
        />
      </div>
      <div class="tile-grid">
        {
          previewTiles.map((tile) => (
            <a class={`tile tile--${tile.key} reveal`} href="/campus/">
              <img
                class="tile-photo"
                src={tile.photo}
                alt={tile.photoAlt}
                loading="lazy"
                decoding="async"
              />
              <div class="tile-body">
                <h3>{tile.title}</h3>
                <p>{tile.desc}</p>
              </div>
            </a>
          ))
        }
      </div>
      <p style="margin-top:22px;font-size:12px;color:var(--muted)">
        校园实拍照片由学校师生提供。
      </p>
    </div>
  </section>

  <section class="section section--cream">
    <div class="container">
      <div class="reveal">
        <SectionTitle
          kicker="Moments"
          title="校园动态"
          desc="优质课大赛、班主任家访、运动会与秋天的校园随拍——来自学校官方和师生账号的公开内容。"
        />
      </div>
      <div class="video-grid">
        {previewVideos.map((video) => <VideoCard video={video} />)}
      </div>
      <p style="margin-top:22px;font-size:12px;color:var(--muted)">{douyinNote}</p>
      <p style="margin-top:10px">
        <a href="/news/" style="color:var(--red-700);font-weight:600">查看全部校园动态 →</a>
      </p>
    </div>
  </section>

  <div class="cta-wrap">
    <div class="container">
      <div class="cta reveal">
        <div>
          <h2>想来看看这所学校？</h2>
          <p>
            学校位于固始县城北环路中段。招生信息、校园平面图与联系方式仍在整理中，
            可在「招生信息」与「联系我们」页面查看最新内容。
          </p>
        </div>
        <a class="btn btn-primary" href="/admissions/">招生信息 →</a>
      </div>
    </div>
  </div>

  <script>
    // 首屏大图轮播：有 JS 才启用；无 JS 时只显示第一张，不报错
    const carousel = document.querySelector('[data-carousel]');
    if (carousel) {
      const slides = Array.from(carousel.querySelectorAll('.carousel-slide'));
      const dots = Array.from(carousel.querySelectorAll('.carousel-dot'));
      const arrows = Array.from(carousel.querySelectorAll('.carousel-arrow'));
      const caption = carousel.querySelector('.carousel-caption');
      const dotsWrap = carousel.querySelector('.carousel-dots');
      const viewport = carousel.querySelector('.carousel-viewport');

      if (slides.length > 1 && dotsWrap) {
        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        let index = 0;
        let timer: number | null = null;

        const show = (next: number) => {
          index = (next + slides.length) % slides.length;
          slides.forEach((slide, i) => {
            slide.dataset.active = i === index ? 'true' : 'false';
          });
          dots.forEach((dot, i) => {
            dot.setAttribute('aria-selected', i === index ? 'true' : 'false');
          });
          if (caption) caption.textContent = slides[index].dataset.caption || '';
        };

        const stop = () => {
          if (timer !== null) {
            window.clearInterval(timer);
            timer = null;
          }
        };

        const start = () => {
          if (reducedMotion) return;
          stop();
          timer = window.setInterval(() => show(index + 1), 5200);
        };

        const step = (dir: number) => {
          show(index + dir);
          start();
        };

        dotsWrap.hidden = false;
        dots.forEach((dot, i) =>
          dot.addEventListener('click', () => {
            show(i);
            start();
          })
        );

        arrows.forEach((arrow) =>
          arrow.addEventListener('click', () => step(Number(arrow.dataset.dir) || 1))
        );

        // 手机 / 触控板：左右滑动切换
        let startX = 0;
        let startY = 0;
        let tracking = false;
        viewport?.addEventListener('pointerdown', (event) => {
          if (event.pointerType === 'mouse') return;
          tracking = true;
          startX = event.clientX;
          startY = event.clientY;
        });
        viewport?.addEventListener('pointerup', (event) => {
          if (!tracking) return;
          tracking = false;
          const dx = event.clientX - startX;
          const dy = event.clientY - startY;
          if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy) * 1.2) {
            step(dx < 0 ? 1 : -1);
          }
        });
        viewport?.addEventListener('pointercancel', () => {
          tracking = false;
        });

        // 键盘：聚焦后左右方向键切换
        carousel.addEventListener('keydown', (event) => {
          if (event.key === 'ArrowLeft') {
            event.preventDefault();
            step(-1);
          } else if (event.key === 'ArrowRight') {
            event.preventDefault();
            step(1);
          }
        });

        carousel.addEventListener('pointerenter', stop);
        carousel.addEventListener('pointerleave', start);
        carousel.addEventListener('focusin', stop);
        carousel.addEventListener('focusout', start);
        start();
      }
    }
  </script>
</Base>
